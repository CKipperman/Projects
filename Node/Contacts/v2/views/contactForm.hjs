<form method="post">
  <div class="form-group">
    <label for="first">first:</label>
    <input id="first" name="first" value="{{contact.first}}" />
  </div>
  <div class="form-group">
    <label for="last">last:</label>
    <input id="last" name="last" value="{{contact.last}}" required/>
  </div>
  <div class="form-group">
    <label for="email">email:</label>
    <input id="email" name="email" value="{{contact.email}}" type="email" />
  </div>
  <div class="form-group">
    <label for="phone">phone:</label>
    <input id="phone" name="phone" value="{{contact.phone}}" type="tel" />
  </div>
  <button>add</button>
  <button type="reset">reset</button>
  <button id="cancel" type="button">cancel</button>
</form>