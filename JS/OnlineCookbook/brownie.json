[
    {
        "title": "Brownie",
        "picture": "media/brownie.jpg",
        "ingredients": [
            "2 cups sugar",
            "1 3/4 cups flour",
            "3/4 cups cocoa",
            "1 1/2 tsp baking soda",
            "1 1/2 tsp baking powder",
            "2 eggs",
            "1 cup milk",
            "1/2 cup oil",
            "2 tsp vanilla sugar",
            " 1 cup hot water"
        ],
        "instructions": [
            "Mix everything in a bowl and pour it into a 9 X 13 pan",
            "Bake at 350°F for 50-60 minutes."
        ]
    }
]